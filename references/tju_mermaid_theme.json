{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Times New Roman, Microsoft YaHei, 微软雅黑, Noto Sans CJK SC, sans-serif",
    "fontSize": "24px",
    "background": "#FFFFFF",
    "primaryColor": "#EAF1FB",
    "primaryTextColor": "#000000",
    "primaryBorderColor": "#00337F",
    "secondaryColor": "#00337F",
    "secondaryTextColor": "#FFFFFF",
    "secondaryBorderColor": "#00337F",
    "tertiaryColor": "#FFFFFF",
    "tertiaryTextColor": "#000000",
    "tertiaryBorderColor": "#C00000",
    "lineColor": "#00337F",
    "textColor": "#000000",
    "mainBkg": "#EAF1FB",
    "nodeBorder": "#00337F",
    "clusterBkg": "#FFFFFF",
    "clusterBorder": "#00337F",
    "titleColor": "#00337F",
    "edgeLabelBackground": "#FFFFFF",
    "actorBkg": "#EAF1FB",
    "actorBorder": "#00337F",
    "actorTextColor": "#000000",
    "actorLineColor": "#00337F",
    "signalColor": "#00337F",
    "signalTextColor": "#000000",
    "labelBoxBkgColor": "#00337F",
    "labelBoxBorderColor": "#00337F",
    "labelTextColor": "#FFFFFF",
    "noteBkgColor": "#FFFFFF",
    "noteBorderColor": "#C00000",
    "noteTextColor": "#000000",
    "activationBkgColor": "#EAF1FB",
    "activationBorderColor": "#00337F"
  },
  "themeCSS": ".label, .nodeLabel, .edgeLabel, text { font-weight: bold !important; }",
  "flowchart": { "htmlLabels": true, "curve": "linear", "padding": 16, "nodeSpacing": 40, "rankSpacing": 50 },
  "sequence": { "mirrorActors": false, "actorFontWeight": "bold", "messageFontWeight": "bold" }
}
